{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HAZID Studio",
  "version": "0.2.0",
  "identifier": "com.hazidstudio.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HAZID Studio",
        "width": 1400,
        "height": 880,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "hazid"
        ],
        "name": "HAZID Study",
        "description": "HAZID study file",
        "role": "Editor"
      }
    ]
  }
}